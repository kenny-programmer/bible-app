NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
GEMINI_API_KEY=your-gemini-api-key
# WorkOS AuthKit
# WORKOS_CLIENT_ID=your-workos-client-id
# WORKOS_API_KEY=your-workos-api-key
# WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# WORKOS_COOKIE_PASSWORD=at-least-32-characters-long-secret
# Session cookie lifetime in seconds. 604800 = 7 days. This is a sliding
# (inactivity-based) expiry — it resets each time the session is refreshed,
# so an idle user is auto-logged-out after 7 days without activity.
# WORKOS_COOKIE_MAX_AGE=604800

# Free key from https://scripture.api.bible/ — required for Ang Salita ng Dios (ASND).
SCRIPTURE_API_KEY=
# Optional: set if auto-detection fails (from GET https://api.scripture.api.bible/v1/bibles).
# SCRIPTURE_ASND_BIBLE_ID=
